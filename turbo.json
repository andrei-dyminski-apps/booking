{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "WEB_PORT",
    "API_PORT",
    "API_HOST",
    "PORT",
    "WEB_ORIGIN",
    "API_ORIGIN",
    "SITE_ORIGIN",
    "DATABASE_URL",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "REDIS_PORT",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "AUTH_COOKIE_DOMAIN",
    "TRUST_PROXY",
    "STRIPE_SECRET_KEY",
    "STRIPE_PAYMENT_WEBHOOK_SECRET",
    "STRIPE_PAYOUT_WEBHOOK_SECRET",
    "STRIPE_SITE",
    "STRIPE_PUBLISHABLE_KEY",
    "STRIPE_STAND_IN_URL",
    "DATA_CACHE_IN_MEMORY",
    "E2E_TARGET",
    "E2E_LIVE_PASSWORD",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "DOCKER_*"]
    },
    "test:browser:live": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "PLAYWRIGHT_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
