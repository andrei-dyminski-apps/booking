# Copy to .env: cp .env.example .env

# --- Mode ---
# Set by the runtime, not here — a value in .env would apply to every process at once.
# Two things in the code hang on it, and both fail open when it is unset: Swagger at /docs
# is published, and the auth cookies are sent without the Secure attribute. A deployment
# that forgets this variable is therefore serving its session over plain HTTP as well.
# NODE_ENV=production

# --- Ports ---
WEB_PORT=3100
API_PORT=3101

# --- Hosts ---
# The interface Nest listens on. 0.0.0.0 is required under Docker/WSL
# so that the port is reachable from outside the container.
API_HOST=0.0.0.0

# The API address the Next.js server forwards to. Read on the server only: the browser
# talks to /api on the frontend's own origin, and the route handler behind it is what
# reaches Nest. Changing this is a restart of the frontend, not a rebuild.
API_ORIGIN=http://localhost:3101

# Frontend origin(s) Nest allows via CORS.
# Several — comma-separated: http://localhost:3100,https://booking.example.com
# The application itself no longer needs this — every browser request reaches the API
# through the frontend's own origin — but /docs and any direct client still do.
WEB_ORIGIN=http://localhost:3100

# --- Database ---
# Credentials of the Postgres container from docker-compose.yml (docker compose up -d).
# Compose declares defaults, so the lines below can be left as they are.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# The port the container publishes on this machine. Only the host side moves — inside
# the container Postgres still listens on 5432. Change it when 5432 is already taken.
POSTGRES_PORT=5432

# Connection string for the application. It repeats the values above, the port included
# — nothing links them automatically, so it has to be updated whenever they change.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking

# --- Redis ---
# The port the container publishes on this machine, the same arrangement as POSTGRES_PORT:
# inside the container Redis still listens on 6379.
REDIS_PORT=6379

# Backs the BullMQ queue that releases an unpaid booking hold after 15 minutes. The
# `redis` service in docker-compose.yml listens here, so the port repeats REDIS_PORT.
# No fallback: a missing value stops the API at boot, the same as the database URL and
# the JWT secrets.
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# Signing keys for the JWT pair. Two different keys on purpose: a refresh token must not
# be accepted where an access token is expected. The values below are fine for local
# development and must be replaced anywhere else — generate with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

# Lifetimes in seconds. The access token is short-lived because nothing can revoke it
# before it expires; the refresh token is long-lived and revocable — it has a row in the
# database. The same numbers become the Max-Age of the cookies.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Domain of the auth cookies Nest sets. Empty means "the host that set them", and that is
# now the right answer everywhere: the browser never receives these cookies — the frontend
# proxy takes the pair out of the API's answer and re-issues it for its own origin — so
# the only client that still reads them directly is a browser poking at /docs.
AUTH_COOKIE_DOMAIN=

# How many X-Forwarded-For entries the API may believe. The rate limiter buckets by client
# address, and behind a proxy every request looks like it came from the proxy — one bucket
# for everyone, so a single attacker locks the whole service out.
#
# Express counts the entries from the right, so this is the number of proxies that actually
# APPEND to the header, not the number of hops a request makes. The frontend proxy is not
# one of them: it forwards X-Forwarded-For exactly as it received it. What adds an entry is
# the proxy in front of THIS service, which sees the frontend server as an ordinary client.
#
# Locally there is no such proxy and nothing appends anything, so the honest count is 0.
# On Railway there is one, and the entry it appends sits to the right of the client address
# Vercel wrote — so 2 is what reaches past both. It was 0 and 1 before the browser stopped
# calling the API directly.
#
# Never set it higher than the truth. One entry too many and req.ip stops being the client
# address and becomes a header the client fills in: with TRUST_PROXY=1 and nothing actually
# appending, `curl -H 'X-Forwarded-For: 9.9.9.9'` picks its own bucket and the limit on
# /auth/login never fires.
TRUST_PROXY=0
