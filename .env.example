# Copy to .env: cp .env.example .env

# --- Mode ---
# Set by the runtime, not here — a value in .env would apply to every process at once.
# Two things in the code hang on it, and both fail open when it is unset: Swagger at /docs
# is published, and the auth cookies are sent without the Secure attribute. A deployment
# that forgets this variable is therefore serving its session over plain HTTP as well.
# NODE_ENV=production

# --- Ports ---
WEB_PORT=3100
API_PORT=3101

# --- Hosts ---
# The interface Nest listens on. 0.0.0.0 is required under Docker/WSL
# so that the port is reachable from outside the container.
API_HOST=0.0.0.0

# The API address the Next.js server forwards to. Read on the server only: the browser
# talks to /api on the frontend's own origin, and the route handler behind it is what
# reaches Nest. Changing this is a restart of the frontend, not a rebuild.
API_ORIGIN=http://localhost:3101

# Frontend origin(s) Nest allows via CORS.
# Several — comma-separated: http://localhost:3100,https://staydesk.dev
# The application itself no longer needs this — every browser request reaches the API
# through the frontend's own origin — but /docs and any direct client still do.
WEB_ORIGIN=http://localhost:3100

# The public address of the frontend, which every absolute URL a page states about itself
# is built on: the canonical link, the shared link's og:url, the JSON-LD. Read on the
# server at request time. Left empty, it is Vercel's production domain on Vercel
# (VERCEL_PROJECT_PRODUCTION_URL) and http://localhost:$WEB_PORT anywhere else. Production
# sets it to https://staydesk.dev.
SITE_ORIGIN=

# --- Database ---
# Credentials of the Postgres container from docker-compose.yml (docker compose up -d).
# Compose declares defaults, so the lines below can be left as they are.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# The port the container publishes on this machine. Only the host side moves — inside
# the container Postgres still listens on 5432. Change it when 5432 is already taken.
POSTGRES_PORT=5432

# Connection string for the application. It repeats the values above, the port included
# — nothing links them automatically, so it has to be updated whenever they change.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking

# --- Redis ---
# The port the container publishes on this machine, the same arrangement as POSTGRES_PORT:
# inside the container Redis still listens on 6379.
REDIS_PORT=6379

# Backs the BullMQ queue that releases an unpaid booking hold after 15 minutes, and the
# pub/sub that fans the live event stream (GET /events) out to whichever API instance holds
# a browser's connection. The `redis` service in docker-compose.yml listens here, so the
# port repeats REDIS_PORT.
# No fallback: a missing value stops the API at boot, the same as the database URL and
# the JWT secrets.
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# Signing keys for the JWT pair. Two different keys on purpose: a refresh token must not
# be accepted where an access token is expected. The values below are fine for local
# development and must be replaced anywhere else — generate with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

# Lifetimes in seconds. The access token is short-lived because nothing can revoke it
# before it expires; the refresh token is long-lived and revocable — it has a row in the
# database. The same numbers become the Max-Age of the cookies.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Domain of the auth cookies Nest sets. Empty means "the host that set them", and that is
# now the right answer everywhere: the browser never receives these cookies — the frontend
# proxy takes the pair out of the API's answer and re-issues it for its own origin — so
# the only client that still reads them directly is a browser poking at /docs.
AUTH_COOKIE_DOMAIN=

# How many X-Forwarded-For entries the API may believe. The rate limiter buckets by client
# address, and behind a proxy every request looks like it came from the proxy — one bucket
# for everyone, so a single attacker locks the whole service out.
#
# Express counts the entries from the right, so this is the number of proxies that actually
# APPEND to the header, not the number of hops a request makes. The frontend proxy is not
# one of them: it forwards X-Forwarded-For exactly as it received it. What adds an entry is
# the proxy in front of THIS service, which sees the frontend server as an ordinary client.
#
# Locally there is no such proxy and nothing appends anything, so the honest count is 0.
# On Railway there is one, and the entry it appends sits to the right of the client address
# Vercel wrote — so 2 is what reaches past both. It was 0 and 1 before the browser stopped
# calling the API directly.
#
# Never set it higher than the truth. One entry too many and req.ip stops being the client
# address and becomes a header the client fills in: with TRUST_PROXY=1 and nothing actually
# appending, `curl -H 'X-Forwarded-For: 9.9.9.9'` picks its own bucket and the limit on
# /auth/login never fires.
TRUST_PROXY=0

# --- Payments (Stripe, test mode) ---
# Keys of a Stripe account in test mode: Dashboard -> Developers -> API keys. No real money
# moves with sk_test_/pk_test_ keys, and the test cards in README.md are the only cards
# they accept. There is no fallback for any of the three: a missing value stops the API at
# boot, or fails the payment page with its own name in the message.
#
# The secret key is the API's alone; it opens, cancels and refunds payments.
STRIPE_SECRET_KEY=

# What signs the payment webhook (`/payments/webhook`) deliveries. Locally it is the secret
# `stripe listen` prints when it starts (`docker compose --profile stripe logs stripe`,
# the line with whsec_); deployed, it is the one shown for the endpoint in the Dashboard.
STRIPE_PAYMENT_WEBHOOK_SECRET=

# What signs the payout webhook (`/payouts/webhook`): the news about hosts' payout accounts
# (Connect, thin events), which a deployment registers as a destination of its own.
# Locally optional: unset, it is the secret above — `stripe listen` signs both kinds with
# the one it prints. With NODE_ENV=production there is no fallback.
STRIPE_PAYOUT_WEBHOOK_SECRET=

# The name of this deployment on the payments it opens. A test account is usually shared:
# the deployment and every developer's `stripe listen` hear all of its events, and a
# payment of a booking that only another database holds would otherwise be refunded as one
# whose hold is gone. Locally it falls back to `local` — give each machine sharing an
# account a name of its own; with NODE_ENV=production there is no fallback.
STRIPE_SITE=local

# The publishable key Stripe.js is loaded with. Read by the frontend server and handed to
# the payment form as a prop rather than inlined at build, so switching accounts is a
# restart, not a rebuild.
STRIPE_PUBLISHABLE_KEY=

# Sends every call of the API's Stripe client to a stand-in on this machine instead of
# Stripe. The browser suite's stack runs this way, against the stand-in it starts itself
# (apps/web/e2e/stripe/server.ts), which signs its webhook deliveries with
# STRIPE_PAYMENT_WEBHOOK_SECRET; anywhere else leave it empty. An http(s) origin, with no
# path, on localhost or 127.0.0.1; refused with NODE_ENV=production.
STRIPE_STAND_IN_URL=

# --- Frontend cache ---
# "true" keeps the frontend's Data Cache in the server process instead of under
# .next/cache, so a restart starts with nothing cached. The browser suite's stack sets it,
# since it reseeds its database on every run; anywhere else leave it empty.
DATA_CACHE_IN_MEMORY=

# --- Browser suite ---
# Which stack `pnpm test:browser` runs against (apps/web/e2e/target.ts): empty or
# `hermetic` — the default, Stripe played by the suite's stand-in — or `stripe`, Stripe's
# side real against the sandbox the keys above name. Set by `pnpm test:browser:stripe`
# rather than here: a value in .env would send every browser run to Stripe, and a variable
# the script sets wins over the file anyway.
E2E_TARGET=

# The password of the suite's two accounts on the live demo (apps/web/e2e/live.ts), which
# `pnpm test:browser:live` signs in to. The live workflow takes it from repository secrets, and
# nothing else reads it. Empty unless you run the live target.
E2E_LIVE_PASSWORD=
# Set these to the verified inboxes of replacement live-suite accounts, when needed.
E2E_LIVE_GUEST_EMAIL=
E2E_LIVE_HOST_EMAIL=

# --- Deployment ---
# Set by Vercel itself on every deployment of the frontend (`production`, `preview` or
# `development`) and never by hand. A preview opens the Content-Security-Policy to Vercel's
# toolbar, which only previews draw; left empty locally.
VERCEL_ENV=

# Set by Vercel on every deployment, previews included: the production domain without a
# scheme. What the frontend's absolute URLs fall back to when SITE_ORIGIN is empty, so a
# preview names its pages by production's address. Left empty locally.
VERCEL_PROJECT_PRODUCTION_URL=

# --- Transactional email (API only) ---
# SMTP URL for Mailpit, started by `docker compose up -d`. Open the local inbox at
# http://localhost:8025. Leave this unset in production to use Resend over HTTPS.
MAIL_SMTP_URL=smtp://localhost:1025

# Address shown as the sender. For Resend, use an address on a domain verified for
# sending in the Resend dashboard. The example also works with local Mailpit.
MAIL_FROM=staydesk@mail.staydesk.dev

# Domain used in reply addresses for conversation emails. For production, enable
# receiving for this domain in Resend and publish the receiving MX record it provides.
MAIL_REPLY_DOMAIN=mail.staydesk.dev

# Encrypts pending email requests in Postgres. If empty, the API uses JWT_REFRESH_SECRET.
# Generate a dedicated production value with `openssl rand -hex 32` and keep it stable
# so the API can still read pending requests after JWT secret rotations.
MAIL_SNAPSHOT_SECRET=

# Create a Full access key under API Keys in the Resend dashboard. The API sends email,
# reads incoming replies and checks suppressions. Leave empty when using Mailpit.
RESEND_API_KEY=

# Copy the Signing Secret from the Resend webhook registered at the public API's
# `/webhooks/mail` endpoint. See "Transactional email" in README.md for the event list.
# Leave empty when using Mailpit.
RESEND_WEBHOOK_SECRET=
