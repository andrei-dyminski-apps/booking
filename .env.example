# Copy to .env: cp .env.example .env

# --- Mode ---
# Set by the runtime, not here — a value in .env would apply to every process at once.
# The only thing it switches in the code: Swagger at /docs is not published
# when NODE_ENV=production.
# NODE_ENV=production

# --- Ports ---
WEB_PORT=3000
API_PORT=3001

# --- Hosts ---
# The interface Nest listens on. 0.0.0.0 is required under Docker/WSL
# so that the port is reachable from outside the container.
API_HOST=0.0.0.0

# The API address the browser talks to.
# Inlined into the client bundle at next build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend origin(s) Nest allows via CORS.
# Several — comma-separated: http://localhost:3000,https://booking.example.com
WEB_ORIGIN=http://localhost:3000

# --- Database ---
# Credentials of the Postgres container from docker-compose.yml (docker compose up -d).
# Compose declares defaults, so the lines below can be left as they are.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Connection string for the application. It repeats the values above — nothing links
# them automatically, so it has to be updated whenever the credentials change.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking
