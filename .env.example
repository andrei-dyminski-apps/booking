# Copy to .env: cp .env.example .env

# --- Ports ---
WEB_PORT=3000
API_PORT=3001

# --- Hosts ---
# The interface Nest listens on. 0.0.0.0 is required under Docker/WSL
# so that the port is reachable from outside the container.
API_HOST=0.0.0.0

# The API address the browser talks to.
# Inlined into the client bundle at next build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend origin(s) Nest allows via CORS.
# Several — comma-separated: http://localhost:3000,https://booking.example.com
WEB_ORIGIN=http://localhost:3000
