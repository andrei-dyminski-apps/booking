# Copy to .env: cp .env.example .env

# --- Mode ---
# Set by the runtime, not here — a value in .env would apply to every process at once.
# Two things in the code hang on it, and both fail open when it is unset: Swagger at /docs
# is published, and the auth cookies are sent without the Secure attribute. A deployment
# that forgets this variable is therefore serving its session over plain HTTP as well.
# NODE_ENV=production

# --- Ports ---
WEB_PORT=3000
API_PORT=3001

# --- Hosts ---
# The interface Nest listens on. 0.0.0.0 is required under Docker/WSL
# so that the port is reachable from outside the container.
API_HOST=0.0.0.0

# The API address the browser talks to.
# Inlined into the client bundle at next build time.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend origin(s) Nest allows via CORS.
# Several — comma-separated: http://localhost:3000,https://booking.example.com
WEB_ORIGIN=http://localhost:3000

# --- Database ---
# Credentials of the Postgres container from docker-compose.yml (docker compose up -d).
# Compose declares defaults, so the lines below can be left as they are.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Connection string for the application. It repeats the values above — nothing links
# them automatically, so it has to be updated whenever the credentials change.
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking

# --- Authentication ---
# Signing keys for the JWT pair. Two different keys on purpose: a refresh token must not
# be accepted where an access token is expected. The values below are fine for local
# development and must be replaced anywhere else — generate with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

# Lifetimes in seconds. The access token is short-lived because nothing can revoke it
# before it expires; the refresh token is long-lived and revocable — it has a row in the
# database. The same numbers become the Max-Age of the cookies.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Domain of the auth cookies. Empty means "the host that set them" — which is what local
# development needs: the API on localhost:3001 and the frontend on localhost:3000 share
# the host `localhost`, so the browser sends the cookies to both. In production the two
# live on different subdomains, and the parent domain (.example.com) has to be spelled out
# here — otherwise the frontend never sees the session.
AUTH_COOKIE_DOMAIN=

# Number of proxies in front of the API. The rate limiter buckets by client address, and
# behind a proxy every request looks like it came from the proxy — one bucket for everyone,
# so a single attacker locks the whole service out. 0 is "no proxy, use the socket address"
# and is right for local development; a Railway deployment puts exactly one in front, so 1.
# Never set it higher than the number of proxies that really exist: every trusted hop is one
# more X-Forwarded-For entry a client is free to invent.
TRUST_PROXY=0
