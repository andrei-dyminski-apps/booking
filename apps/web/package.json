{
  "name": "@repo/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "imports": {
    "#_app/*": "./src/_app/*/index.ts",
    "#_pages/*": "./src/_pages/*/index.ts",
    "#features/*": "./src/features/*/index.ts",
    "#shared/*": "./src/shared/*/index.ts"
  },
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${WEB_PORT:-3000}",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 && steiger ./src",
    "lint:fix": "eslint --fix",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@repo/contracts": "workspace:^",
    "@repo/ui": "workspace:*",
    "lucide-react": "^1.33.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "postcss": "^8.5.26",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  }
}
