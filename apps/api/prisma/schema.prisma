generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // No extensions in imports: both tsc (nest build) and ts-node (seed) resolve the .ts files.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A stay taken by a guest on one listing. The two relations are what the authorization
/// rules of phase 3 are written against: the guest may cancel their own booking, the owner
/// of the listing may read the bookings against it, an admin may do both.
model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  guestId   String   @map("guest_id") @db.Uuid
  from      DateTime @map("from_date") @db.Date
  to        DateTime @map("to_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  /// The lifecycle of the stay. A booking is born a hold (`PENDING_PAYMENT`) that holds
  /// the slot for the length of `expiresAt`; phase 6 turns a paid one `CONFIRMED`.
  /// `CANCELLED` and `EXPIRED` are terminal and free the slot — only the first two count
  /// as active, which is the set the overlap check and the `EXCLUDE` constraint act on.
  status BookingStatus @default(PENDING_PAYMENT)

  /// When the hold lapses. A BullMQ job scheduled for this moment flips a still-pending
  /// hold to `EXPIRED`, a repeatable sweep catches the ones whose job was lost, and the
  /// locking transaction that creates the next booking does the same lazily. The column
  /// is not cleared when the booking leaves `PENDING_PAYMENT`: when a hold stopped
  /// holding is what a refund asks about, and `status` is what says whether it still does.
  ///
  /// Nullable for the statuses that no longer hold by a deadline, and never for the one
  /// that does: `bookings_hold_has_deadline` is a raw-SQL CHECK constraint
  /// (`require_a_deadline_on_every_hold`), because `lapsedHolds` and `holdsTheSlot` are
  /// written around this column and a NULL would make both of them NULL — a hold visible
  /// to the `EXCLUDE` constraint and to nothing else.
  expiresAt DateTime? @map("expires_at")

  /// Restrict, not Cascade: the bookings of other people are not something a listing may
  /// quietly take down with it. What an owner asks for is answered without ever reaching
  /// this key — `DELETE /listings/:id` retires the listing and leaves the row where it
  /// is, see `deleted_at` below.
  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  guest   User     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@index([listingId, from, to])
  /// Serves both halves of hold expiry: the repeatable sweep, which asks for every lapsed
  /// hold there is, and the lazy one inside `create`, which asks the same question and
  /// then filters by listing. `listingId` is deliberately not the leading column — that
  /// would leave the sweep without an index — and the job that releases one named hold
  /// goes by primary key, so it needs none of this.
  @@index([status, expiresAt])
  /// The four below are `GET /bookings`, which is a keyset page: each is a pair the cursor
  /// carries (`ORDER_BY` in `booking.repository.ts`), and the tiebreaker follows the
  /// direction of the key so that one btree read backwards answers the other direction —
  /// two per key rather than four, the same arithmetic as the catalogue's.
  ///
  /// Unlike the catalogue's, none of them is partial: every status is readable here, so
  /// nothing narrows these reads the way `deleted_at IS NULL` narrows a listing. That is
  /// what lets them be declared on the model instead of in a raw-SQL migration.
  ///
  /// The plain pair serves the admin's scope, which is every stay on the site and the only
  /// one with no ceiling; behind `guest_id` it serves a guest's own history — and it
  /// replaces the bare `@@index([guestId])` that used to be here, which was its prefix.
  /// The owner's scope gets none: it narrows by `listings.owner_id`, a column of another
  /// table, so no index of this one can hold the filter and the ordering together. What
  /// bounds it is the owner's own listings rather than the site, which is why that is a
  /// trade worth making instead of denormalising the column onto every booking.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([from(sort: Desc), id(sort: Desc)])
  @@index([guestId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([guestId, from(sort: Desc), id(sort: Desc)])
  @@map("bookings")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// What one side of a finished stay said about the other. `kind` is both what the review
/// is about and who wrote it — `LISTING` is the guest's, `GUEST` is the host's — so there
/// is no author column: the booking already names both people, and a third key could only
/// disagree with it.
///
/// No listing or guest column either. Both lists of reviews are reached through the
/// booking (`booking.listing_id`, `booking.guest_id`), each of which is indexed on
/// `bookings`, and the unique pair below finds the review of each stay. What that read
/// costs is bounded by the stays of one listing or one guest rather than by the site — the
/// same trade the owner's scope of `GET /bookings` makes — and copying the two ids onto
/// this table would be two columns to keep in step with a row that already holds them.
model Review {
  id        String     @id @default(uuid()) @db.Uuid
  bookingId String     @map("booking_id") @db.Uuid
  kind      ReviewKind
  /// Whole stars, 1 to 5. The bounds are the contract's (`MIN_RATING`, `MAX_RATING`) and
  /// are written on the column again as the raw-SQL `CHECK` `reviews_rating_within_contract`,
  /// for the writes that go around the API — the seed, `psql` — exactly as the ceiling on a
  /// price is.
  rating    Int        @db.SmallInt
  comment   String
  createdAt DateTime   @default(now()) @map("created_at")

  /// Cascade: a review is about a stay and means nothing without it. Bookings are never
  /// deleted by the API — cancelling keeps the row — so what reaches this is a guest's
  /// account going with their bookings, and the test and seed cleanups.
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// One review of each kind per stay. It is also what the two lists join through — a
  /// booking's review of a given kind is one seek on this pair.
  @@unique([bookingId, kind])
  @@map("reviews")
}

enum ReviewKind {
  LISTING
  GUEST
}

/// A place to stay. `price_per_night` is an amount of the currency itself, exact to the
/// cent: `numeric(10, 2)` rather than a float, because a float stores neither 120.10 nor
/// the sum of a stay's nights exactly and the error accumulates across them. The contract
/// refuses anything finer than a cent, so the two scales agree — and the ceiling agrees
/// too, which the type alone cannot say: the column holds a hundred times what `MAX_PRICE`
/// in `@repo/contracts` allows, so the number itself is written as the `CHECK` constraint
/// `listings_price_within_contract` (the raw-SQL migration `bound_prices_to_the_contract`)
/// and a write that bypasses the API cannot leave a price the API would then refuse to
/// read back.
model Listing {
  id            String    @id @default(uuid()) @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  title         String
  description   String
  pricePerNight Decimal   @map("price_per_night") @db.Decimal(10, 2)
  capacity      Int
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  /// When the owner retired it. The row outlives that moment because the bookings above
  /// point at it and a guest's stay has to keep naming where it was: `Restrict` would
  /// refuse the delete outright, and refusing is not an answer an owner with one finished
  /// stay in their history can ever get past. A retired listing is not in the catalogue,
  /// not on its owner's dashboard and not bookable — `ListingRepository` is where all
  /// three of those are one `where`.
  deletedAt     DateTime? @map("deleted_at")

  /// Restrict, not Cascade, for the reason the booking above is: a cascade from `users`
  /// would have to delete listings that bookings restrict, so it would promise an account
  /// deletion the database refuses to perform. Removing an owner therefore lets go of the
  /// listings first. Nothing in the API reaches that path any more — retiring is what
  /// `DELETE /listings/:id` does — so what the constraint guards now is the hard delete
  /// of the seed, the test cleanup and whatever account deletion turns out to be.
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bookings      Booking[]
  conversations Conversation[]

  /// The exceptions to `price_per_night`, which stays the default: a price for a day of
  /// the week and a price for one date. Which of the three a night costs is decided by
  /// `nightlyPrice` in `@repo/contracts`, not by the database.
  weekdayPrices ListingWeekdayPrice[]
  datePrices    ListingDatePrice[]

  @@index([ownerId])
  /// What the filter boxes of the stays look a listing up by: any part of its title,
  /// regardless of case (`GET /lookups/listings`). A btree cannot seek a `%part%`, a
  /// trigram index can — `pg_trgm` is installed by the migration that created this, since
  /// Prisma declares no extensions — and three characters, the shortest search the
  /// contract takes, are exactly one trigram.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_title_trgm_idx")
  /// The indexes the catalogue reads by are not here, and cannot be: both are partial on
  /// `deleted_at IS NULL` — the condition every read of this table outside a stay carries
  /// — and each is ordered by a pair the keyset cursor of `GET /listings` names,
  /// `created_at DESC, id DESC` and `price_per_night, id`. One per key rather than one per
  /// value of `sort`: the tiebreaker follows the direction of the key, so each btree is
  /// read backwards for the other direction. `@@index` spells neither the WHERE nor the
  /// sort, so they are raw-SQL migrations (`index_offered_listings_for_the_catalogue`,
  /// `index_offered_listings_by_price`) like the EXCLUDE constraint above.
  @@map("listings")
}

/// Lower-case, unlike the other enums: these are the very values `weekdaySchema` in
/// `@repo/contracts` names the keys of a listing's weekday prices with, so the row and the
/// contract need no table between them.
enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

/// What every night falling on `weekday` costs, instead of the listing's default. One row
/// per day at most — the pair is the key — and a day without one costs the default.
///
/// Cascade, unlike the listing's other relations: a price is a property of the listing
/// rather than a record of somebody else's, and nothing in the API hard-deletes a listing
/// anyway — only the seed and the test cleanup do, and they should not have to name this
/// table to do it. The price obeys the same `CHECK` as `listings.price_per_night`
/// (`listing_weekday_prices_price_within_contract`, raw SQL in the migration that made the
/// table), for the reason given there.
model ListingWeekdayPrice {
  listingId String  @map("listing_id") @db.Uuid
  weekday   Weekday
  price     Decimal @db.Decimal(10, 2)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, weekday])
  @@map("listing_weekday_prices")
}

/// What the night starting on `date` costs, ahead of both the weekday price and the
/// default. The key is the pair again, which is what the contract's "one price per date"
/// says on this end, and it is also the index the listing page reads the upcoming dates
/// through. Past rows are not deleted on a timer: they stop being read the day they pass,
/// and the next save of the listing's prices replaces the set, past rows included.
model ListingDatePrice {
  listingId String   @map("listing_id") @db.Uuid
  date      DateTime @db.Date
  price     Decimal  @db.Decimal(10, 2)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, date])
  @@map("listing_date_prices")
}

enum Role {
  USER
  OWNER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// What the person goes by, as they typed it at registration — not unique, never a key.
  /// Accounts that predate the column were given the part of their address before the `@`.
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  /// When an admin shut the account. A blocked user cannot sign in or refresh a session,
  /// and blocking deletes every refresh token they hold in the same transaction — what is
  /// left is an access token, which runs out within `JWT_ACCESS_TTL` because `JwtStrategy`
  /// reads no database. A moment rather than a flag, because when it happened is the first
  /// thing whoever reopens the account asks. Blocking is what the API offers instead of
  /// deleting a user: the rows are kept, and so is everything that points at them.
  blockedAt DateTime? @map("blocked_at")

  refreshTokens RefreshToken[]
  listings      Listing[]
  bookings      Booking[]
  conversations Conversation[]
  notifications Notification[]

  /// `GET /users` is a keyset page ordered by `created_at` with `id` behind it — the pair
  /// `user-cursor.ts` encodes. One index serves both directions, the same arithmetic as the
  /// bookings': the tiebreaker follows the key, so `oldest` is this btree read backwards.
  /// `role` and the status get none: they have three and two values.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  /// `email` is a substring match no btree can seek — the `email` filter of `GET /users`
  /// and the account lookups of the filter boxes (`GET /lookups/owners`, `/lookups/guests`)
  /// — so it gets a trigram index, the same one the listings' titles have and for the same
  /// reason.
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  /// The account lookups search the name first — the address only for an admin — so it
  /// gets one too. No btree orders by it, for the reason `listings.title` has none: the rows
  /// a search matches are sorted, not the table.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_name_trgm_idx")
  @@map("users")
}

/// One row per issued refresh token. Rotation replaces a row with its successor inside the
/// same family, so a token that comes back after it was replaced is a replay: the whole
/// family is revoked at once. Only the SHA-256 of the token is stored — a leaked table
/// yields nothing usable, and unlike an argon2 hash it can be looked up by equality.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The pair rather than userId alone: it serves a lookup by user just as well, and it is
  // what the sweep of expired rows in RefreshTokenRepository.deleteExpired runs on.
  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One thread between a guest and the host of one listing — the host being whoever owns
/// it, which is why no column names them: the owner is read through the listing, so the
/// thread is addressed to the same person every other rule about that listing is.
/// One per pair (`@@unique` below): asking about the same listing again continues it.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  guestId   String   @map("guest_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  /// When the newest message was written — denormalised from `messages` because it is the
  /// key the list of conversations is ordered and paged by, and an index cannot order by an
  /// aggregate of another table. Written in the same transaction as the message itself.
  lastMessageAt DateTime @map("last_message_at")

  /// The newest message's text and side, denormalised beside its moment for the list: every
  /// card shows it, and reading it through the relation loads every message of every thread
  /// on the page — Prisma applies a nested `take` in memory when it has several parents.
  /// Written by the same `UPDATE` as `last_message_at`, under the thread's lock.
  lastMessageBody   String           @map("last_message_body")
  lastMessageSender ConversationSide @map("last_message_sender")

  /// When each side last opened the thread. A conversation is unread for a side while the
  /// newest message is later than this; sending stamps the sender's own column, so what
  /// one writes is never news to oneself. `NULL` is a side that has never opened it — the
  /// host, until they first read what the guest sent.
  guestReadAt DateTime? @map("guest_read_at")
  hostReadAt  DateTime? @map("host_read_at")

  /// Restrict, for the reason a booking restricts its listing: a listing is retired rather
  /// than deleted, and the thread keeps naming it the way a stay does.
  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  guest    User      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, guestId])
  /// `GET /conversations` is a keyset page ordered by the newest message with `id` behind
  /// it. A guest's scope is a seek on this index; a host's narrows by `listings.owner_id`, a
  /// column of another table, so it gets none of its own — the same trade the owner's scope
  /// of the stays makes, bounded by the host's listings rather than by the site.
  @@index([guestId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

/// What one side of a conversation wrote. The author is a side rather than an account: the
/// two people are fixed by the conversation, so the side is the whole of what a row has to
/// say about who wrote it.
model Message {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  sender         ConversationSide
  body           String
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// A thread is read from its end, a page at a time: the newest first, `id` behind it.
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

/// Mirrored by `conversationSideSchema` in `@repo/contracts`.
enum ConversationSide {
  GUEST
  HOST
}

enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  REVIEW_RECEIVED
}

/// Something that happened which one account should hear about. `type` and `data` are one
/// value of `notificationContentSchema` in `@repo/contracts`: the column is `jsonb` because
/// each type carries a shape of its own, and the repository parses it against the contract
/// on the way out rather than trusting what is stored — the same treatment a cursor gets.
///
/// The data is a copy of what was true at the time (a listing's title, the dates of a
/// stay), not a key resolved on read: what the recipient was told stays what they were
/// told after the listing is renamed or retired. That is also why there is no foreign key
/// to the booking or the review — a notice outlives neither, and is about both.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  data      Json
  /// When the recipient read it; `null` is unread. A moment rather than a flag, for the
  /// reason `users.blocked_at` is one.
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  /// Cascade: a notice is its recipient's alone and means nothing without them.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The feed of one account, newest first — the pair the keyset cursor carries, behind
  /// the recipient. The unread count has an index of its own that Prisma cannot spell
  /// (partial on `read_at IS NULL`), in the raw SQL of the migration that made the table.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}
