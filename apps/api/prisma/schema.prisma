generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // No extensions in imports: both tsc (nest build) and ts-node (seed) resolve the .ts files.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id")
  guestName String   @map("guest_name")
  from      DateTime @map("from_date") @db.Date
  to        DateTime @map("to_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, from, to])
  @@map("bookings")
}

enum Role {
  USER
  OWNER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

/// One row per issued refresh token. Rotation replaces a row with its successor inside the
/// same family, so a token that comes back after it was replaced is a replay: the whole
/// family is revoked at once. Only the SHA-256 of the token is stored — a leaked table
/// yields nothing usable, and unlike an argon2 hash it can be looked up by equality.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The pair rather than userId alone: it serves a lookup by user just as well, and it is
  // what the sweep of expired rows in RefreshTokenRepository.deleteExpired runs on.
  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}
