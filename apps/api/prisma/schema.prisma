generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // No extensions in imports: both tsc (nest build) and ts-node (seed) resolve the .ts files.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A stay taken by a guest on one listing. The two relations are what the authorization
/// rules of phase 3 are written against: the guest may cancel their own booking, the owner
/// of the listing may read the bookings against it, an admin may do both.
model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  guestId   String   @map("guest_id") @db.Uuid
  from      DateTime @map("from_date") @db.Date
  to        DateTime @map("to_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  /// Restrict, not Cascade: a listing with stays booked against it is not something an
  /// owner may make disappear, and the service answers 409 rather than letting the
  /// database quietly delete the bookings of other people.
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  guest   User    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([listingId, from, to])
  @@index([guestId])
  @@map("bookings")
}

/// A place to stay. `price_per_night` is an integer in the minor unit of the currency:
/// money in a float accumulates rounding across the nights of a stay, and phase 5 hands
/// this value to a Stripe PaymentIntent, which takes minor units as well.
model Listing {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  title         String
  description   String
  pricePerNight Int      @map("price_per_night")
  capacity      Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// Restrict, not Cascade, for the reason the booking above is: a cascade from `users`
  /// would have to delete listings that bookings restrict, so it would promise an account
  /// deletion the database refuses to perform. Removing an owner therefore lets go of the
  /// listings first, and a listing with stays booked against it refuses to go — the same
  /// 409 the API answers when that listing is deleted on its own.
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([ownerId])
  @@map("listings")
}

enum Role {
  USER
  OWNER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  listings      Listing[]
  bookings      Booking[]

  @@map("users")
}

/// One row per issued refresh token. Rotation replaces a row with its successor inside the
/// same family, so a token that comes back after it was replaced is a replay: the whole
/// family is revoked at once. Only the SHA-256 of the token is stored — a leaked table
/// yields nothing usable, and unlike an argon2 hash it can be looked up by equality.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The pair rather than userId alone: it serves a lookup by user just as well, and it is
  // what the sweep of expired rows in RefreshTokenRepository.deleteExpired runs on.
  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}
