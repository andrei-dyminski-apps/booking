generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // No extensions in imports: both tsc (nest build) and ts-node (seed) resolve the .ts files.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A stay taken by a guest on one listing. The two relations are what the authorization
/// rules of phase 3 are written against: the guest may cancel their own booking, the owner
/// of the listing may read the bookings against it, an admin may do both.
model Booking {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  guestId   String   @map("guest_id") @db.Uuid
  from      DateTime @map("from_date") @db.Date
  to        DateTime @map("to_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  /// The lifecycle of the stay. A booking is born a hold (`PENDING_PAYMENT`) that holds
  /// the slot for the length of `expiresAt`; phase 6 turns a paid one `CONFIRMED`.
  /// `CANCELLED` and `EXPIRED` are terminal and free the slot — only the first two count
  /// as active, which is the set the overlap check and the `EXCLUDE` constraint act on.
  status BookingStatus @default(PENDING_PAYMENT)

  /// When the hold lapses. A BullMQ job scheduled for this moment flips a still-pending
  /// hold to `EXPIRED`, a repeatable sweep catches the ones whose job was lost, and the
  /// locking transaction that creates the next booking does the same lazily. The column
  /// is not cleared when the booking leaves `PENDING_PAYMENT`: when a hold stopped
  /// holding is what a refund asks about, and `status` is what says whether it still does.
  ///
  /// Nullable for the statuses that no longer hold by a deadline, and never for the one
  /// that does: `bookings_hold_has_deadline` is a raw-SQL CHECK constraint
  /// (`require_a_deadline_on_every_hold`), because `lapsedHolds` and `holdsTheSlot` are
  /// written around this column and a NULL would make both of them NULL — a hold visible
  /// to the `EXCLUDE` constraint and to nothing else.
  expiresAt DateTime? @map("expires_at")

  /// Restrict, not Cascade: the bookings of other people are not something a listing may
  /// quietly take down with it. What an owner asks for is answered without ever reaching
  /// this key — `DELETE /listings/:id` retires the listing and leaves the row where it
  /// is, see `deleted_at` below.
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  guest   User    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([listingId, from, to])
  /// Serves both halves of hold expiry: the repeatable sweep, which asks for every lapsed
  /// hold there is, and the lazy one inside `create`, which asks the same question and
  /// then filters by listing. `listingId` is deliberately not the leading column — that
  /// would leave the sweep without an index — and the job that releases one named hold
  /// goes by primary key, so it needs none of this.
  @@index([status, expiresAt])
  /// The four below are `GET /bookings`, which is a keyset page: each is a pair the cursor
  /// carries (`ORDER_BY` in `booking.repository.ts`), and the tiebreaker follows the
  /// direction of the key so that one btree read backwards answers the other direction —
  /// two per key rather than four, the same arithmetic as the catalogue's.
  ///
  /// Unlike the catalogue's, none of them is partial: every status is readable here, so
  /// nothing narrows these reads the way `deleted_at IS NULL` narrows a listing. That is
  /// what lets them be declared on the model instead of in a raw-SQL migration.
  ///
  /// The plain pair serves the admin's scope, which is every stay on the site and the only
  /// one with no ceiling; behind `guest_id` it serves a guest's own history — and it
  /// replaces the bare `@@index([guestId])` that used to be here, which was its prefix.
  /// The owner's scope gets none: it narrows by `listings.owner_id`, a column of another
  /// table, so no index of this one can hold the filter and the ordering together. What
  /// bounds it is the owner's own listings rather than the site, which is why that is a
  /// trade worth making instead of denormalising the column onto every booking.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([from(sort: Desc), id(sort: Desc)])
  @@index([guestId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([guestId, from(sort: Desc), id(sort: Desc)])
  @@map("bookings")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// A place to stay. `price_per_night` is an amount of the currency itself, exact to the
/// cent: `numeric(10, 2)` rather than a float, because a float stores neither 120.10 nor
/// the sum of a stay's nights exactly and the error accumulates across them. The contract
/// refuses anything finer than a cent, so the two scales agree — and the ceiling agrees
/// too, which the type alone cannot say: the column holds a hundred times what `MAX_PRICE`
/// in `@repo/contracts` allows, so the number itself is written as the `CHECK` constraint
/// `listings_price_within_contract` (the raw-SQL migration `bound_prices_to_the_contract`)
/// and a write that bypasses the API cannot leave a price the API would then refuse to
/// read back.
model Listing {
  id            String    @id @default(uuid()) @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  title         String
  description   String
  pricePerNight Decimal   @map("price_per_night") @db.Decimal(10, 2)
  capacity      Int
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  /// When the owner retired it. The row outlives that moment because the bookings above
  /// point at it and a guest's stay has to keep naming where it was: `Restrict` would
  /// refuse the delete outright, and refusing is not an answer an owner with one finished
  /// stay in their history can ever get past. A retired listing is not in the catalogue,
  /// not on its owner's dashboard and not bookable — `ListingRepository` is where all
  /// three of those are one `where`.
  deletedAt     DateTime? @map("deleted_at")

  /// Restrict, not Cascade, for the reason the booking above is: a cascade from `users`
  /// would have to delete listings that bookings restrict, so it would promise an account
  /// deletion the database refuses to perform. Removing an owner therefore lets go of the
  /// listings first. Nothing in the API reaches that path any more — retiring is what
  /// `DELETE /listings/:id` does — so what the constraint guards now is the hard delete
  /// of the seed, the test cleanup and whatever account deletion turns out to be.
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([ownerId])
  /// The indexes the catalogue reads by are not here, and cannot be: both are partial on
  /// `deleted_at IS NULL` — the condition every read of this table outside a stay carries
  /// — and each is ordered by a pair the keyset cursor of `GET /listings` names,
  /// `created_at DESC, id DESC` and `price_per_night, id`. One per key rather than one per
  /// value of `sort`: the tiebreaker follows the direction of the key, so each btree is
  /// read backwards for the other direction. `@@index` spells neither the WHERE nor the
  /// sort, so they are raw-SQL migrations (`index_offered_listings_for_the_catalogue`,
  /// `index_offered_listings_by_price`) like the EXCLUDE constraint above.
  @@map("listings")
}

enum Role {
  USER
  OWNER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  listings      Listing[]
  bookings      Booking[]

  @@map("users")
}

/// One row per issued refresh token. Rotation replaces a row with its successor inside the
/// same family, so a token that comes back after it was replaced is a replay: the whole
/// family is revoked at once. Only the SHA-256 of the token is stored — a leaked table
/// yields nothing usable, and unlike an argon2 hash it can be looked up by equality.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The pair rather than userId alone: it serves a lookup by user just as well, and it is
  // what the sweep of expired rows in RefreshTokenRepository.deleteExpired runs on.
  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}
