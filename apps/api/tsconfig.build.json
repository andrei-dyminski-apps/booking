{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Next to the output it is wiped with it by `deleteOutDir`; derived from `rootDir` it would
    // land outside `dist`, survive the wipe and make the next `nest build` emit nothing.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "**/*.fakes.ts", "prisma", "scripts", "prisma.config.ts"]
}
